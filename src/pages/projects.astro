---

<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Karya & Portfolio Lengkap | Aril</title>
    <style is:global>
      * { margin: 0; padding: 0; box-sizing: border-box; }
      body { background-color: #030712; color: #fff; font-family: system-ui, -apple-system, sans-serif; overflow-x: hidden; }
    </style>
  </head>
  <body>
    <CustomCursor />

    <main class="vault-container">
      <div class="header-nav">
        <a href="/" class="back-btn">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
          Kembali ke Beranda
        </a>
      </div>

      <div class="vault-header">
        <span class="vault-badge">SHOWCASE VAULT</span>
        <h1 class="vault-title">Galeri Karya, Desain & <span class="cyan-text">Sertifikat</span></h1>
        <p class="vault-sub">Kumpulan proyek pengembangan sistem web, dokumentasi video sinematik, artwork grafis, dan sertifikasi kredensial resmi.</p>

        <!-- Filter Tab -->
        <div class="filter-tabs">
          <button class="tab-btn active" data-filter="all">Semua ({allProjects.length})</button>
          <button class="tab-btn" data-filter="cert">Sertifikat Credly</button>
          <button class="tab-btn" data-filter="code">Web Dev</button>
          <button class="tab-btn" data-filter="video">Video Editing</button>
          <button class="tab-btn" data-filter="design">Desain & Poster</button>
        </div>
      </div>

      <!-- Grid 3 Kolom Kartu Galeri -->
      <div class="vault-grid">
        {allProjects.map(item => (
          <div 
            class="project-card" 
            data-category={item.category}
            data-title={item.title}
            data-categorylabel={item.categoryLabel}
            data-toolslabel={item.toolsLabel}
            data-tools={JSON.stringify(item.tools)}
            data-desc={item.fullDesc}
            data-img={item.img}
            data-videourl={item.videoUrl}
            data-credlyurl={item.credlyUrl}
          >
            <!-- Thumbnail Visual Sebelum Diklik -->
            <div class={`card-thumb-wrap ${item.isBadge ? 'badge-thumb-bg' : ''}`}>
              <img src={item.img} alt={item.title} class={`card-thumb ${item.isBadge ? 'badge-img' : ''}`} loading="lazy" />
              <span class="card-badge-floating">{item.categoryLabel}</span>
            </div>

            <!-- Konten Kartu -->
            <div class="card-content">
              <h3 class="card-title">{item.title}</h3>
              <p class="card-desc">{item.desc}</p>
              
              <div class="card-footer">
                <div class="tag-row">
                  {item.tools.slice(0, 2).map(t => <span class="tag-pill">{t}</span>)}
                  {item.tools.length > 2 && <span class="tag-pill">+{item.tools.length - 2}</span>}
                </div>
                <div class="card-arrow">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M7 17L17 7M17 7H7M17 7V17"/></svg>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </main>

    <!-- Modal Popup Detail Proyek & Sertifikat -->
    <div id="project-modal" class="modal-overlay">
      <div class="modal-content">
        <button id="modal-close" class="modal-close-btn">&times;</button>
        
        <div class="modal-img-wrap">
          <img id="modal-img" src="" alt="Preview Proyek" />
        </div>

        <div class="modal-body">
          <div class="modal-meta-row">
            <span id="modal-cat" class="modal-badge">Kategori</span>
          </div>

          <h3 id="modal-title">Judul Proyek</h3>
          <p id="modal-desc">Deskripsi lengkap proyek.</p>

          <div class="modal-tools-section">
            <span id="modal-tools-label" class="tools-heading">Software:</span>
            <div id="modal-tools-container" class="tools-pills-row"></div>
          </div>

          <!-- Tombol Tonton Reels jika video -->
          <div id="modal-action-row" class="modal-action-row" style="display: none;">
            <a id="modal-video-link" href="#" target="_blank" class="video-btn">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
              Tonton Video Dokumentasi (Instagram)
            </a>
          </div>

          <!-- Tombol Verifikasi Credly jika sertifikat -->
          <div id="modal-credly-row" class="modal-action-row" style="display: none;">
            <a id="modal-credly-link" href="#" target="_blank" class="credly-btn">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"/></svg>
              Verifikasi Kredensial Resmi di Credly
            </a>
          </div>
        </div>
      </div>
    </div>

    <script>
      // Filter Logic
      const filterBtns = document.querySelectorAll('.tab-btn');
      const cards = document.querySelectorAll('.project-card');

      filterBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          filterBtns.forEach(b => b.classList.remove('active'));
          btn.classList.add('active');

          const filterValue = btn.getAttribute('data-filter');

          cards.forEach(card => {
            const cardCategory = card.getAttribute('data-category');
            if (filterValue === 'all' || filterValue === cardCategory) {
              (card as HTMLElement).style.display = 'flex';
            } else {
              (card as HTMLElement).style.display = 'none';
            }
          });
        });
      });

      // Modal Logic
      const modal = document.getElementById('project-modal');
      const closeBtn = document.getElementById('modal-close');
      const modalImg = document.getElementById('modal-img') as HTMLImageElement;
      const modalCat = document.getElementById('modal-cat');
      const modalTitle = document.getElementById('modal-title');
      const modalDesc = document.getElementById('modal-desc');
      const modalToolsLabel = document.getElementById('modal-tools-label');
      const modalToolsContainer = document.getElementById('modal-tools-container');
      const modalActionRow = document.getElementById('modal-action-row');
      const modalVideoLink = document.getElementById('modal-video-link') as HTMLAnchorElement;
      const modalCredlyRow = document.getElementById('modal-credly-row');
      const modalCredlyLink = document.getElementById('modal-credly-link') as HTMLAnchorElement;

      cards.forEach(card => {
        card.addEventListener('click', () => {
          if (!modal) return;
          const title = card.getAttribute('data-title') || '';
          const catLabel = card.getAttribute('data-categorylabel') || '';
          const toolsLabel = card.getAttribute('data-toolslabel') || 'Tools';
          const tools = JSON.parse(card.getAttribute('data-tools') || '[]');
          const desc = card.getAttribute('data-desc') || '';
          const img = card.getAttribute('data-img') || '';
          const videoUrl = card.getAttribute('data-videourl') || '';
          const credlyUrl = card.getAttribute('data-credlyurl') || '';

          if (modalTitle) modalTitle.textContent = title;
          if (modalCat) modalCat.textContent = catLabel;
          if (modalDesc) modalDesc.textContent = desc;
          if (modalImg) modalImg.src = img;
          if (modalToolsLabel) modalToolsLabel.textContent = `${toolsLabel}:`;

          if (modalToolsContainer) {
            modalToolsContainer.innerHTML = '';
            tools.forEach((t: string) => {
              const span = document.createElement('span');
              span.className = 'tool-item';
              span.textContent = t;
              modalToolsContainer.appendChild(span);
            });
          }

          // Handle Video Link
          if (videoUrl && modalActionRow && modalVideoLink) {
            modalActionRow.style.display = 'block';
            modalVideoLink.href = videoUrl;
          } else if (modalActionRow) {
            modalActionRow.style.display = 'none';
          }

          // Handle Credly Link
          if (credlyUrl && modalCredlyRow && modalCredlyLink) {
            modalCredlyRow.style.display = 'block';
            modalCredlyLink.href = credlyUrl;
          } else if (modalCredlyRow) {
            modalCredlyRow.style.display = 'none';
          }

          modal.classList.add('active');
        });
      });

      closeBtn?.addEventListener('click', () => modal?.classList.remove('active'));
      modal?.addEventListener('click', (e) => {
        if (e.target === modal) modal.classList.remove('active');
      });
    </script>

    <style>
      .vault-container {
        max-width: 1140px;
        margin: 0 auto;
        padding: 3rem 1.5rem 6rem;
      }
      .header-nav { margin-bottom: 2.5rem; }
      .back-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: #94a3b8;
        text-decoration: none;
        font-weight: 600;
        transition: color 0.2s;
      }
      .back-btn:hover { color: #22d3ee; }

      .vault-header { text-align: center; max-width: 750px; margin: 0 auto 3rem; }
      .vault-badge {
        font-family: monospace;
        font-size: 0.75rem;
        color: #22d3ee;
        background: rgba(6, 182, 212, 0.1);
        border: 1px solid rgba(6, 182, 212, 0.3);
        padding: 4px 12px;
        border-radius: 9999px;
      }
      .vault-title { font-size: 2.5rem; font-weight: 800; margin: 1rem 0 0.6rem; }
      .cyan-text { color: #22d3ee; }
      .vault-sub { color: #94a3b8; font-size: 0.95rem; line-height: 1.6; }

      /* Filter Tabs */
      .filter-tabs {
        display: flex;
        justify-content: center;
        gap: 8px;
        flex-wrap: wrap;
        margin-top: 1.8rem;
      }
      .tab-btn {
        background: rgba(15, 23, 42, 0.7);
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: #94a3b8;
        padding: 8px 18px;
        border-radius: 9999px;
        font-size: 0.85rem;
        cursor: pointer;
        transition: all 0.2s;
      }
      .tab-btn.active, .tab-btn:hover {
        background: #06b6d4;
        color: #030712;
        border-color: #06b6d4;
        font-weight: 700;
      }

      /* Grid 3 Kolom */
      .vault-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1.5rem;
      }

      .project-card {
        background: rgba(15, 23, 42, 0.65);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 16px;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        cursor: pointer;
        transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        backdrop-filter: blur(8px);
      }

      .project-card:hover {
        transform: translateY(-6px);
        border-color: #22d3ee;
        box-shadow: 0 12px 30px rgba(6, 182, 212, 0.2);
      }

      /* Thumbnail Card */
      .card-thumb-wrap {
        position: relative;
        width: 100%;
        height: 190px;
        background: #050b14;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .card-thumb {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.4s ease;
      }

      .project-card:hover .card-thumb {
        transform: scale(1.05);
      }

      /* Khusus Badge Credly */
      .badge-thumb-bg {
        background: radial-gradient(circle at center, #0f172a 0%, #030712 100%);
        padding: 1.5rem;
      }
      .badge-img {
        width: auto !important;
        height: 100% !important;
        object-fit: contain !important;
      }

      .card-badge-floating {
        position: absolute;
        top: 10px;
        left: 10px;
        font-size: 0.68rem;
        font-family: monospace;
        color: #22d3ee;
        background: rgba(3, 7, 18, 0.8);
        border: 1px solid rgba(34, 211, 238, 0.35);
        backdrop-filter: blur(6px);
        padding: 3px 8px;
        border-radius: 9999px;
      }

      /* Content Card */
      .card-content {
        padding: 1.25rem;
        display: flex;
        flex-direction: column;
        flex-grow: 1;
        justify-content: space-between;
      }

      .card-title {
        font-size: 1.05rem;
        font-weight: 700;
        color: #f8fafc;
        margin-bottom: 0.4rem;
        line-height: 1.4;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }

      .card-desc {
