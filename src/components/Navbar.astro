<style>
  .floating-navbar-container {
    position: fixed;
    bottom: 24px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 900;
    display: flex;
    justify-content: center;
    animation: navbarSlideUp 1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes navbarSlideUp {
    0% {
      opacity: 0;
      transform: translate(-50%, 80px);
    }
    100% {
      opacity: 1;
      transform: translate(-50%, 0);
    }
  }

  .capsule-nav {
    display: flex;
    align-items: center;
    gap: 8px;
    background: rgba(10, 15, 29, 0.85);
    border: 2px solid #000000;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.7), inset 0 0 0 1px rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(16px);
    padding: 6px 8px;
    border-radius: 9999px;
  }

  .nav-item {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 8px 12px;
    border-radius: 9999px;
    color: #94a3b8;
    text-decoration: none;
    transition: all 0.25s ease;
  }

  .nav-item:hover {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.08);
  }

  .nav-item.active {
    background: #3b82f6;
    color: #ffffff;
    font-weight: 700;
    padding: 8px 16px;
    box-shadow: 0 0 15px rgba(59, 130, 246, 0.5);
  }

  .nav-label {
    font-size: 0.85rem;
  }

  .nav-contact-btn {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: #000000;
    border: 1px solid rgba(255, 255, 255, 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    text-decoration: none;
    transition: all 0.25s ease;
    margin-left: 4px;
  }

  .nav-contact-btn:hover {
    background: #06b6d4;
    color: #030712;
    transform: scale(1.08);
  }

  @media (max-width: 640px) {
    .floating-navbar-container {
      bottom: 16px;
      width: 92%;
    }
    .capsule-nav {
      width: 100%;
      justify-content: space-around;
      padding: 6px;
    }
  }
</style>