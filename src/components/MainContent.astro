    <div class="section-badge">SKILLS OVERVIEW</div>
    <h2 class="section-title">Keahlian & <span class="cyan-text">Kemampuan</span></h2>

    <div class="skills-grid">
      <div class="skill-card">
        <div class="skill-icon">⚡</div>
        <h3>Web & Backend</h3>
        <p>Pengembangan antarmuka responsif dan perancangan arsitektur database backend teroptimasi.</p>
      </div>

      <div class="skill-card">
        <div class="skill-icon">🎨</div>
        <h3>Design & Layout</h3>
        <p>Eksplorasi tipografi modern, layout visual grafis, dan estetika antarmuka.</p>
      </div>

      <div class="skill-card">
        <div class="skill-icon">🎬</div>
        <h3>Video & Visuals</h3>
        <p>Editing video ritmik dengan dynamic pacing, sound design, dan dokumentasi acara.</p>
      </div>
    </div>
  </section>

  <!-- ================= LIFE LOGS ================= -->
  <section id="lifelogs" class="section-container">
    <div class="section-badge">TIMELINE</div>
    <h2 class="section-title">Life <span class="cyan-text">Logs</span></h2>

    <div class="timeline">
      {lifeLogs.map(log => (
        <div class="timeline-item">
          <div class="timeline-dot"></div>
          <div class="timeline-content">
            <span class="timeline-year">{log.year}</span>
            <h3>{log.title}</h3>
            <p>{log.desc}</p>
          </div>
