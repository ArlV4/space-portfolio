    <div class="section-badge">TECH STACK</div>
    <h2 class="section-title">Tools & <span class="cyan-text">Teknologi</span></h2>

    <div class="marquee-wrapper">
      <div class="fade-mask left-mask"></div>
      <div class="fade-mask right-mask"></div>

      <!-- Baris 1: Gerak Kiri -->
      <div class="marquee-track track-left">
        <div class="marquee-group">
          {row1.map(tech => (
            <div class="tech-pill">
              <i class={tech.icon}></i>
              <span>{tech.name}</span>
            </div>
          ))}
        </div>
        <div class="marquee-group" aria-hidden="true">
          {row1.map(tech => (
            <div class="tech-pill">
              <i class={tech.icon}></i>
              <span>{tech.name}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Baris 2: Gerak Kanan -->
      <div class="marquee-track track-right">
        <div class="marquee-group">
          {row2.map(tech => (
            <div class="tech-pill">
              <i class={tech.icon}></i>
              <span>{tech.name}</span>
            </div>
          ))}
        </div>
        <div class="marquee-group" aria-hidden="true">
          {row2.map(tech => (
            <div class="tech-pill">
              <i class={tech.icon}></i>
              <span>{tech.name}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ================= FEATURED WORKS (4 CARD BERFOTO) ================= -->
  <section id="projects" class="section-container">
    <div class="section-header-flex">
      <div>
        <div class="section-badge">FEATURED WORKS</div>
        <h2 class="section-title">Project & <span class="cyan-text">Sertifikat Pilihan</span></h2>
      </div>
      <a href="/projects" class="view-all-btn">
        View All Projects
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
    </div>

    <!-- Grid 4 Card (2x2 di Tablet, 4 Kolom di Layar Lebar) -->
    <div class="featured-grid">
      {featuredProjects.map(item => (
        <div 
          class="featured-card" 
          data-title={item.title} 
          data-categorylabel={item.categoryLabel}
          data-toolslabel={item.toolsLabel}
          data-tools={JSON.stringify(item.tools)}
          data-desc={item.fullDesc} 
          data-img={item.img}
          data-videourl={item.videoUrl}
          data-credlyurl={item.credlyUrl}
        >
          <div class={`card-img-wrap ${item.isBadge ? 'badge-bg' : ''}`}>
            <img src={item.img} alt={item.title} class={`card-img ${item.isBadge ? 'badge-fit' : ''}`} loading="lazy" />
            <span class="card-badge">{item.categoryLabel}</span>
          </div>

          <div class="card-info">
            <h3 class="card-title">{item.title}</h3>
            <p class="card-desc">{item.desc}</p>
            
            <div class="card-meta">
              <div class="tag-row">
                {item.tools.slice(0, 2).map(t => <span class="tag-item">{t}</span>)}
              </div>
              <div class="card-arrow">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M7 17L17 7M17 7H7M17 7V17"/></svg>
              </div>
            </div>
          </div>
        </div>
      ))}
